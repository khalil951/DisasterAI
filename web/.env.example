# Copy to .env.local. These values stay on the server: the browser never sees them and cannot choose a target.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/incident
# Demo mode sends to the replay webhook (python scripts/replay_webhook.py): saved real answers, no model calls, shown as "Demo data".
REPLAY_WEBHOOK_URL=http://localhost:5690/webhook/incident?delay=3
RAG_URL=http://localhost:8010
OLLAMA_URL=http://localhost:11434
# The repository root (where eval/, vision/ and rag/ live), relative to this folder.
REPO_ROOT=..
